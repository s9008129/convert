# ============================================================
# .env.local (本地開發專用)
# 政府智慧會議紀錄生成系統 v3.0 - 環境變數本地覆蓋
# ============================================================
#
# 📋 用途：
#   - 覆蓋 .env 中的全局設定，僅在本地開發時生效
#   - 避免提交敏感資訊到版本控制
#   - 支援多開發者各自的環境配置
#
# 🚀 使用方式：
#   1. 複製此檔案為 .env.local
#   2. 根據需要編輯變數
#   3. 執行 docker compose up 時會自動載入
#   4. 優先級：.env.local > .env
#
# ⚠️ 注意：.env.local 已加入 .gitignore，不會上傳 Git
#
# ============================================================

# ========================================
# 雲端 LLM provider（雲端模式；v4.7.1 起預設為 Ollama Cloud）
# ========================================
# provider 切換：ollama_cloud（預設）| gemini
# CLOUD_LLM_PROVIDER=ollama_cloud
# Ollama Cloud 金鑰（預設 provider；https://ollama.com/settings/keys）
# OLLAMA_API_KEY=your-ollama-api-key-here
# 切回 Gemini：CLOUD_LLM_PROVIDER=gemini，並設定 GEMINI_API_KEY
# GEMINI_API_KEY=your-api-key-here

# ========================================
# 檔案上傳限制
# ========================================
MAX_FILE_SIZE_MB=200
ENABLE_BATCH_UPLOAD=false

# ========================================
# 並發處理設定
# ========================================
MAX_CONCURRENT_TASKS=1
QUEUE_MAX_SIZE=50

# ========================================
# Ollama 連接
# ========================================
# Windows/Mac: 使用 host.docker.internal
# Linux: 使用 172.17.0.1 或實際主機 IP
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=gemma4:31b
# 小記憶體 Mac 可另外設定，例如：
# LOCAL_LLM_MODEL_MAC=gemma4:<較小標籤>

# ========================================
# Whisper 語音辨識（此範例僅適用 Windows/Linux/Docker）
# ========================================
# macOS 原生服務（T20260912-2242-01 起）僅接受 ASR_BACKEND=auto 或 apple：
# auto＝Apple SpeechAnalyzer（唯一引擎、永不 fallback）；顯式
# transformers / faster_whisper / mlx_whisper 會讓服務啟動時直接失敗（fail-loud，刻意設計）。
ASR_BACKEND=transformers
WHISPER_MODEL=MediaTek-Research/Breeze-ASR-26
WHISPER_MODEL_REVISION=949c87bca9dbe90e160cf739460cc765e80805f3
WHISPER_LANGUAGE=auto
WHISPER_DEVICE=auto

# ========================================
# 系統日誌
# ========================================
LOG_LEVEL=DEBUG
DEFAULT_MODE=local

# ========================================
# 開發模式特殊設定
# ========================================
# 啟用自動重載
UVICORN_RELOAD=true

# 開發伺服器詳細日誌
DEVELOPMENT_MODE=true
