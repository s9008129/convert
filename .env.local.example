# ============================================================
# .env.local (本地開發專用)
# MeetingScribe v3.0 - 環境變數本地覆蓋
# ============================================================
#
# 📋 用途：
#   - 覆蓋 .env 中的全局設定，僅在本地開發時生效
#   - 避免提交敏感資訊到版本控制
#   - 支援多開發者各自的環境配置
#
# 🚀 使用方式：
#   1. 複製此檔案為 .env.local
#   2. 根據需要編輯變數
#   3. 執行 docker compose up 時會自動載入
#   4. 優先級：.env.local > .env
#
# ⚠️ 注意：.env.local 已加入 .gitignore，不會上傳 Git
#
# ============================================================

# ========================================
# Gemini API Key（雲端模式）
# ========================================
# GEMINI_API_KEY=your-api-key-here

# ========================================
# 檔案上傳限制
# ========================================
MAX_FILE_SIZE_MB=200
ENABLE_BATCH_UPLOAD=false

# ========================================
# 並發處理設定
# ========================================
MAX_CONCURRENT_TASKS=1
QUEUE_MAX_SIZE=50

# ========================================
# Ollama 連接
# ========================================
# Windows/Mac: 使用 host.docker.internal
# Linux: 使用 172.17.0.1 或實際主機 IP
OLLAMA_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=gemma3:27b-it-qat

# ========================================
# Whisper 語音辨識
# ========================================
WHISPER_MODEL=medium
WHISPER_DEVICE=auto

# ========================================
# 系統日誌
# ========================================
LOG_LEVEL=DEBUG
DEFAULT_MODE=local

# ========================================
# 開發模式特殊設定
# ========================================
# 啟用自動重載
UVICORN_RELOAD=true

# 開發伺服器詳細日誌
DEVELOPMENT_MODE=true
