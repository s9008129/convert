# ============================================
# 政府智慧會議紀錄生成系統 環境變數配置
# 請複製此檔案為 .env 並填入實際值
# ============================================

# ========================================
# 雲端 LLM provider 設定（雲端模式使用；v4.7.1 起可切換 provider）
# ========================================
# provider 切換：gemini（預設）| ollama_cloud（OpenAI 相容端點）
# CLOUD_LLM_PROVIDER=gemini
#
# 【Gemini（預設 provider）】
# 取得 API Key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
#
# 【Ollama Cloud（選用；設定 CLOUD_LLM_PROVIDER=ollama_cloud 時生效）】
# 切換：CLOUD_LLM_PROVIDER=ollama_cloud
# 取得 API Key: https://ollama.com/settings/keys
# OLLAMA_API_KEY=your_ollama_api_key_here
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
# OLLAMA_CLOUD_MODEL=deepseek-v4.1-flash

# ========================================
# 檔案上傳限制（v2.1 新增）
# ========================================
# 單檔大小上限（MB）
MAX_FILE_SIZE_MB=200
# 是否允許批次上傳（true/false）
ENABLE_BATCH_UPLOAD=false

# ========================================
# 排隊系統設定（v2.1 新增）
# ========================================
# 最大同時處理任務數
MAX_CONCURRENT_TASKS=1
# 排隊佇列最大長度
QUEUE_MAX_SIZE=50

# ========================================
# 進階設定（通常不需要修改）
# ========================================
# 本地 LLM provider：Apple Silicon auto 使用 LM Studio；其他平台 auto 保留既有優先順序
# LOCAL_LLM_PROVIDER=auto       # auto | lmstudio | ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LOCAL_LLM_MODEL=gemma4:31b

# LM Studio 設定（native API root；不要寫死模型名稱）
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234
# LMSTUDIO_MODEL=             # optional exact model key 或 loaded instance id

# Gemini 設定（預設 provider 生效；CLOUD_LLM_PROVIDER=gemini）
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-3.5-flash-lite
# CLOUD_LLM_SEGMENTED_EXTRACTION=false # 雲端是否分段萃取（預設 false＝單次呼叫；true 可回退 v4.3.3 分段）
# CLOUD_LLM_CHUNK_TOKENS=3200          # 分段萃取分塊大小（僅在分段模式生效）
# CLOUD_LLM_MAX_CONCURRENT_REQUESTS=3  # 分段萃取併發請求上限（僅在分段模式生效；避免 API rate limit）

# Whisper 設定
# ASR_BACKEND=transformers             # 非 macOS 專用；macOS 僅接受 auto / apple
# WHISPER_MODEL=MediaTek-Research/Breeze-ASR-26
# WHISPER_MODEL_REVISION=949c87bca9dbe90e160cf739460cc765e80805f3
# WHISPER_LANGUAGE=auto
# WHISPER_DEVICE=auto

# ========================================
# Apple SpeechAnalyzer 本機 ASR（僅 macOS 生效；Windows/Linux 請保持未設定）
# ========================================
# macOS 26+ / Apple Silicon 且 ASR_BACKEND=auto 時，一律使用 Apple 本機引擎
# （SpeechAnalyzer，macOS 內建模型、免下載 HF 模型）。macOS 僅接受
# ASR_BACKEND=auto 或 apple；Apple 失敗一律 fail-closed（直接失敗，不回退 Whisper）。
# APPLE_SPEECH_CLI_PATH=               # apple-speech-cli 執行檔路徑（空=依序搜尋 repo release 產物→PATH；不自動編譯）
# APPLE_LOCALE=zh-Hant-TW
# APPLE_PRESET=time-indexed            # time-indexed 才有逐詞時間軸
# APPLE_ENABLE_PREFLIGHT=true          # MP3 等脆弱容器先預轉 16k mono WAV（效能關鍵）
# 建置與診斷請見 doc/apple-speech-analyzer-operations.md

# ========================================
# ASR 品質參數（v4.2 新增，P1-6 實證參數組）
# ========================================
# ASR_INITIAL_PROMPT=以下是台灣繁體中文的會議記錄。
# ASR_ENABLE_HOTWORDS=true            # 將 data/glossary/ 詞彙表注入 ASR
# ASR_CONDITION_ON_PREVIOUS_TEXT=false # 長檔防重複迴圈，建議保持 false
# ASR_COMPRESSION_RATIO_THRESHOLD=2.2
# ASR_NO_SPEECH_THRESHOLD=0.5
# ASR_REPETITION_PENALTY=1.1
# ASR_NO_REPEAT_NGRAM_SIZE=3
# ASR_VAD_MIN_SILENCE_MS=500
# ASR_CHUNK_STRIDE_SECONDS=5           # transformers 路徑重疊解碼秒數

# ========================================
# 逐字稿語意校正（v4.2 新增，P1-2~P1-4）
# ========================================
# ENABLE_TRANSCRIPT_CORRECTION=true
# CORRECTION_SCOPE=all                 # all=全部段落 / auto=詞彙表命中 / off=停用
# CORRECTION_MAX_CHANGE_RATIO=0.10     # 單段改動超過 10% 即整段放棄（防過度改寫）
# GLOSSARY_DIR=                        # 空值 = 專案內 data/glossary

# ========================================
# 本地 LLM 效能（v4.2 新增，P0-7 / P2-2；v4.2.2 實測校調）
# ========================================
# LOCAL_LLM_KEEP_ALIVE=30m             # 多階段流程間保留模型，避免重載 20GB（v4.7.0 調 30m）
# LOCAL_LLM_EFFECTIVE_CONTEXT_TOKENS=16384  # f16 KV 實測 23.0/24GB 貼死上限；主機啟用 KV 量化後 ~21GB
# LOCAL_LLM_RESERVED_OUTPUT_TOKENS=2048
# LOCAL_LLM_DISABLE_THINKING=true      # 思考型模型（gemma4）務必保持 true：
#                                      # thinking 與正文共用 num_predict 預算，
#                                      # 不關閉會導致紀錄極短甚至為空（實測根因）
#                                      # 本變數僅在 Ollama／provider 支援時生效；
#                                      # LM Studio 採 response-aware bounded retry
# LMSTUDIO_REASONING_RETRY_MAX_TOKENS=8192  # reasoning-only 回應（content 空 + finish_reason=length）
#                                      # 的 bounded retry 上限：retry cap 取 provider headroom、
#                                      # 本值與「initial*2、observed reasoning+initial+256」最小值；
#                                      # retry 後仍無正文即回報 LMSTUDIO_NO_FINAL_CONTENT。
#                                      # correction 呼叫已停用 retry（allow_reasoning_retry=False）
# ===== v4.7.0 VRAM offload 根治 =====
# LOCAL_LLM_REQUEST_TIMEOUT=1800       # 單次生成總時長上限（串流化後放寬——寧可等待不截斷）
# LOCAL_LLM_STREAM_IDLE_TIMEOUT=120    # 串流 chunk 間閒置逾時（快速偵測真正卡死）
# LOCAL_LLM_MIN_TOKENS_PER_SECOND=5.0  # 吞吐低於此值警告疑似 CPU offload
# LOCAL_LLM_DEGRADED_CONTEXT_TOKENS=8192  # warmup 自我修復失敗時本任務降級 num_ctx（無主機權限時的自動保底）
# ASR_ISOLATION=subprocess             # ASR 子程序隔離（VRAM 保證歸還）；inprocess=回退桿
# ASR_WORKER_TIMEOUT_SECONDS=7200
# ★ Ollama 主機【必要】設定（在 Ollama 服務端，不是這裡）：
#   OLLAMA_FLASH_ATTENTION=1
#   OLLAMA_KV_CACHE_TYPE=q8_0          # KV cache 減半，需搭配 flash attention 才生效
#   設定後務必驗證是否真的生效（setx 常因 tray app 未重啟／GPO 管制而無效）：
#   → 被管制時改用 scripts/start_ollama_optimized.ps1（行內程序級環境變數啟動）
#   → 驗證用 scripts/diagnose_ollama_host.ps1（server.log 傾印＋/api/ps 載入量）

# 系統設定
# LOG_LEVEL=INFO
# DEFAULT_MODE=local
# ALLOWED_ORIGINS=*                    # 生產環境請改為明確來源，如 http://10.97.15.58:9527
