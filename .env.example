# ============================================
# MeetingScribe 環境變數配置
# 請複製此檔案為 .env 並填入實際值
# ============================================

# ========================================
# Gemini API 設定（雲端模式使用）
# ========================================
# 取得 API Key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# 檔案上傳限制（v2.1 新增）
# ========================================
# 單檔大小上限（MB）
MAX_FILE_SIZE_MB=200
# 是否允許批次上傳（true/false）
ENABLE_BATCH_UPLOAD=false

# ========================================
# 排隊系統設定（v2.1 新增）
# ========================================
# 最大同時處理任務數
MAX_CONCURRENT_TASKS=1
# 排隊佇列最大長度
QUEUE_MAX_SIZE=50

# ========================================
# 進階設定（通常不需要修改）
# ========================================
# Ollama 設定（預設 gemma4:31b；Windows 若只安裝 q4 變體可交由後端自動解析）
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LOCAL_LLM_MODEL=gemma4:31b
# LOCAL_LLM_MODEL_MAC=gemma4:<較小標籤>  # 小記憶體 Mac 可額外覆蓋

# LM Studio 設定（OpenAI 相容 API）
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# LMSTUDIO_MODEL=gpt-oss-20b

# Gemini 設定
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-3.1-flash-lite

# Whisper 設定
# ASR_BACKEND=transformers
# WHISPER_MODEL=MediaTek-Research/Breeze-ASR-26
# WHISPER_MODEL_REVISION=949c87bca9dbe90e160cf739460cc765e80805f3
# WHISPER_LANGUAGE=auto
# WHISPER_DEVICE=auto

# ========================================
# ASR 品質參數（v4.2 新增，P1-6 實證參數組）
# ========================================
# ASR_INITIAL_PROMPT=以下是台灣繁體中文的會議記錄。
# ASR_ENABLE_HOTWORDS=true            # 將 data/glossary/ 詞彙表注入 ASR
# ASR_CONDITION_ON_PREVIOUS_TEXT=false # 長檔防重複迴圈，建議保持 false
# ASR_COMPRESSION_RATIO_THRESHOLD=2.2
# ASR_NO_SPEECH_THRESHOLD=0.5
# ASR_REPETITION_PENALTY=1.1
# ASR_NO_REPEAT_NGRAM_SIZE=3
# ASR_VAD_MIN_SILENCE_MS=500
# ASR_CHUNK_STRIDE_SECONDS=5           # transformers 路徑重疊解碼秒數

# ========================================
# 逐字稿語意校正（v4.2 新增，P1-2~P1-4）
# ========================================
# ENABLE_TRANSCRIPT_CORRECTION=true
# CORRECTION_SCOPE=all                 # all=全部段落 / auto=詞彙表命中 / off=停用
# CORRECTION_MAX_CHANGE_RATIO=0.10     # 單段改動超過 10% 即整段放棄（防過度改寫）
# GLOSSARY_DIR=                        # 空值 = 專案內 data/glossary

# ========================================
# 本地 LLM 效能（v4.2 新增，P0-7 / P2-2；v4.2.2 實測校調）
# ========================================
# LOCAL_LLM_KEEP_ALIVE=10m             # 多階段流程間保留模型，避免重載 20GB
# LOCAL_LLM_EFFECTIVE_CONTEXT_TOKENS=16384  # 4090 實測 23.0/24GB 可承載；預設 8192 保守值
# LOCAL_LLM_RESERVED_OUTPUT_TOKENS=2048
# LOCAL_LLM_DISABLE_THINKING=true      # 思考型模型（gemma4）務必保持 true：
#                                      # thinking 與正文共用 num_predict 預算，
#                                      # 不關閉會導致紀錄極短甚至為空（實測根因）
# ★ Ollama 主機建議同時設定（在 Ollama 服務端，不是這裡）：
#   OLLAMA_FLASH_ATTENTION=1
#   OLLAMA_KV_CACHE_TYPE=q8_0          # KV cache 減半，需搭配 flash attention 才生效

# 系統設定
# LOG_LEVEL=INFO
# DEFAULT_MODE=local
# ALLOWED_ORIGINS=*                    # 生產環境請改為明確來源，如 http://10.97.15.58:9527
