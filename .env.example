# ============================================
# MeetingScribe 環境變數配置
# 請複製此檔案為 .env 並填入實際值
# ============================================

# ========================================
# Gemini API 設定（雲端模式使用）
# ========================================
# 取得 API Key: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ========================================
# 檔案上傳限制（v2.1 新增）
# ========================================
# 單檔大小上限（MB）
MAX_FILE_SIZE_MB=200
# 是否允許批次上傳（true/false）
ENABLE_BATCH_UPLOAD=false

# ========================================
# 排隊系統設定（v2.1 新增）
# ========================================
# 最大同時處理任務數
MAX_CONCURRENT_TASKS=1
# 排隊佇列最大長度
QUEUE_MAX_SIZE=50

# ========================================
# 進階設定（通常不需要修改）
# ========================================
# Ollama 設定（預設 gemma4:31b；Windows 若只安裝 q4 變體可交由後端自動解析）
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LOCAL_LLM_MODEL=gemma4:31b
# LOCAL_LLM_MODEL_MAC=gemma4:<較小標籤>  # 小記憶體 Mac 可額外覆蓋

# LM Studio 設定（OpenAI 相容 API）
# LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# LMSTUDIO_MODEL=gpt-oss-20b

# Gemini 設定
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-2.5-flash-lite

# Whisper 設定
# ASR_BACKEND=transformers
# WHISPER_MODEL=MediaTek-Research/Breeze-ASR-26
# WHISPER_MODEL_REVISION=949c87bca9dbe90e160cf739460cc765e80805f3
# WHISPER_LANGUAGE=auto
# WHISPER_DEVICE=auto

# 系統設定
# LOG_LEVEL=INFO
# DEFAULT_MODE=local
