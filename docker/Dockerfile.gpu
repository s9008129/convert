# ============================================
# MeetingScribe - 會議轉錄工具 Docker 映像
# v3.4 - GPU CUDA 加速版本
# ============================================
# 根據 faster-whisper 官方文檔，GPU 執行需要：
# - cuBLAS for CUDA 12
# - cuDNN 9 for CUDA 12
# 使用官方 NVIDIA CUDA 映像作為基礎

# ========== 建置階段 ==========
FROM nvidia/cuda:12.3.2-cudnn9-devel-ubuntu22.04 AS builder

# 設定環境變數
ENV DEBIAN_FRONTEND=noninteractive

# 安裝 Python 和編譯依賴
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    build-essential \
    pkg-config \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    && rm -rf /var/lib/apt/lists/*

# 設定 Python 別名
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

WORKDIR /build

# 複製依賴檔案並安裝到虛擬環境
COPY requirements.txt .
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 安裝依賴（使用 CUDA 版本的 ctranslate2）
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir av==12.0.0 && \
    pip install --no-cache-dir -r requirements.txt

# ========== 運行階段 ==========
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

# 設定環境變數
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Taipei \
    PATH="/opt/venv/bin:$PATH" \
    # CUDA 設定
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    # 預設配置
    MAX_FILE_SIZE_MB=500 \
    ENABLE_BATCH_UPLOAD=true \
    MAX_CONCURRENT_TASKS=2 \
    QUEUE_MAX_SIZE=100 \
    # Whisper GPU 設定
    WHISPER_DEVICE=cuda \
    WHISPER_COMPUTE_TYPE=float16

# 安裝運行時依賴
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# 建立非 root 用戶
RUN useradd -m -u 1000 appuser

# 設定工作目錄
WORKDIR /app

# 從建置階段複製虛擬環境
COPY --from=builder /opt/venv /opt/venv

# 複製應用程式碼
COPY --chown=appuser:appuser . .

# 預載 Whisper 模型（使用 GPU 配置）
# 注意：首次運行時會下載模型到容器內
RUN python -c "from faster_whisper import WhisperModel; WhisperModel('medium', device='cpu', compute_type='int8')" || true

# 建立資料目錄
RUN mkdir -p /app/data/uploads /app/data/outputs /app/data/cache /app/models && \
    chown -R appuser:appuser /app/data /app/models

# 切換到非 root 用戶
USER appuser

# 暴露端口
EXPOSE 9527

# 健康檢查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:9527/api/health || exit 1

# 啟動命令
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "9527"]
