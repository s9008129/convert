# ============================================
# MeetingScribe - GPU 加速版 Docker 映像
# v4.0 - 新增 DOCX 下載功能 + NVIDIA CUDA 12 + cuDNN 8 + cuDNN 9
# ============================================
# 
# 重要：Whisper 語音識別需要 cuDNN 8
# 根據 CTranslate2 官方文件：
# "If you plan to run models with convolutional layers 
#  (e.g. for speech recognition), you should also install 
#  cuDNN 8 for CUDA 12.x."
# - 參考: https://opennmt.net/CTranslate2/installation.html
#
# 使用方式：
#   cd docker
#   docker compose -f docker-compose-windows-gpu.yml build
#   docker compose -f docker-compose-windows-gpu.yml up -d
# ============================================

# ========== 建置階段 ==========
# 使用 NVIDIA 官方 CUDA + cuDNN 映像作為基底
# cuDNN 9 基底映像，之後額外安裝 cuDNN 8 庫
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04 AS base

# 設定環境變數
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Taipei \
    DEBIAN_FRONTEND=noninteractive \
    # CUDA 環境
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    # faster-whisper 需要的 CUDA 庫路徑
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH

# 安裝 Python 3.11 和基礎依賴
# 注意：需要安裝 FFmpeg 開發庫以編譯 av (PyAV) 套件
# 重要：需要額外安裝 cuDNN 8 庫 (libcudnn8) 以支援 Whisper 語音識別
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    build-essential \
    pkg-config \
    # FFmpeg 執行檔和開發庫（編譯 PyAV/av 套件需要）
    ffmpeg \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    libswresample-dev \
    curl \
    git \
    wget \
    gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.11 /usr/bin/python3 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

# ========== 安裝 cuDNN 8 庫 ==========
# CTranslate2 的 Whisper 推理需要 cuDNN 8 (libcudnn_ops_infer.so.8)
# 即使基底映像有 cuDNN 9，語音識別模型仍需要 cuDNN 8
# 從 NVIDIA 官方源安裝 cuDNN 8 for CUDA 12
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libcudnn8=8.9.7.29-1+cuda12.2 \
    && rm -rf /var/lib/apt/lists/* \
    && ldconfig

# ========== 建置依賴階段 ==========
FROM base AS builder

WORKDIR /build

# 複製依賴檔案
COPY requirements.txt .

# 建立虛擬環境並安裝依賴
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# 安裝 Python 套件
# 注意：ctranslate2 需要 CUDA 12 + cuDNN 9
# 注意：faster-whisper 需要 av==11.*，會自動安裝
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    # 安裝支援 CUDA 12 的 PyTorch
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

# v4.2 語意校正依賴（獨立小層，~3MB；勿併入上面的大層，會毀掉快取）
COPY requirements-correction.txt .
RUN pip install --no-cache-dir -r requirements-correction.txt

# ========== 運行階段 ==========
FROM base AS runtime

# 設定環境變數
ENV PATH="/opt/venv/bin:$PATH" \
    # 預設配置
    MAX_FILE_SIZE_MB=100 \
    ENABLE_BATCH_UPLOAD=false \
    MAX_CONCURRENT_TASKS=1 \
    QUEUE_MAX_SIZE=50 \
    # 模型快取目錄設定（Breeze-ASR-26 持久化於 named volume）
    # 這樣模型只需下載一次，rebuild 時自動使用快取
    HF_HOME=/app/models/huggingface \
    XDG_CACHE_HOME=/app/models/cache \
    TRANSFORMERS_CACHE=/app/models/transformers

# 建立非 root 用戶
RUN useradd -m -u 1000 appuser

# 設定工作目錄
WORKDIR /app

# 從建置階段複製虛擬環境
COPY --from=builder /opt/venv /opt/venv

# 複製應用程式碼
COPY --chown=appuser:appuser . .

# 建立模型目錄（會被 volume 覆蓋）
# 注意：不在 build 時下載模型，而是在運行時首次使用時下載
# 這樣可以利用 volume 持久化，避免每次 rebuild 重新下載
RUN mkdir -p /app/models && chown -R appuser:appuser /app/models

# 建立資料目錄
RUN mkdir -p /app/data/uploads /app/data/outputs /app/data/cache /app/models && \
    chown -R appuser:appuser /app/data /app/models

# 切換到非 root 用戶
USER appuser

# 暴露端口
EXPOSE 9527

# 健康檢查
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:9527/api/health || exit 1

# 啟動應用
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "9527"]
