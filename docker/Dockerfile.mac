# ============================================
# MeetingScribe - macOS 專用 Docker 映像
# v2.1 - CPU 模式（macOS Docker 不支援 GPU 直通）
# ============================================

# 基礎映像：使用 Python 官方映像（macOS 不需要 CUDA）
FROM python:3.11-slim-bookworm

# 設定環境變數
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Taipei \
    # 預設配置
    MAX_FILE_SIZE_MB=100 \
    ENABLE_BATCH_UPLOAD=false \
    MAX_CONCURRENT_TASKS=1 \
    QUEUE_MAX_SIZE=50 \
    # macOS 專用設定
    WHISPER_DEVICE=cpu

# 安裝系統依賴
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    pkg-config \
    gcc \
    g++ \
    libavformat-dev \
    libavcodec-dev \
    libavdevice-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    && rm -rf /var/lib/apt/lists/*

# 建立非 root 用戶
RUN useradd -m -u 1000 appuser

# 設定工作目錄
WORKDIR /app

# 複製依賴檔案
COPY requirements.txt .

# 安裝 Python 依賴（不含 CUDA）
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r requirements.txt

# 複製應用程式碼
COPY --chown=appuser:appuser . .

# 預載 Whisper 模型（建構時下載，打包進映像）
# macOS 使用 CPU + int8 量化
# 使用 medium 模型：輸出直接為台灣繁體中文，無需簡繁轉換
RUN python3 -c "from faster_whisper import WhisperModel; WhisperModel('medium', device='cpu', compute_type='int8')" || true

# 建立資料目錄
RUN mkdir -p /app/data/uploads /app/data/outputs /app/data/cache /app/models && \
    chown -R appuser:appuser /app/data /app/models

# 切換到非 root 用戶
USER appuser

# 暴露端口
EXPOSE 9527

# 健康檢查
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:9527/api/health || exit 1

# 啟動命令
CMD ["python3", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "9527"]
